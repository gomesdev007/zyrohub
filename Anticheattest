--==================================================
-- PARSE VECTOR3
--==================================================

local function getTargetPosition()
	local text = PositionBox.Text

	-- Aceita:
	-- Vector3.new(100, 50, -200)
	-- Vector3.new(100,50,-200)

	local x, y, z = text:match(
		"Vector3%.new%s*%(%s*([%-%.%d]+)%s*,%s*([%-%.%d]+)%s*,%s*([%-%.%d]+)%s*%)"
	)

	if not x then
		return nil
	end

	x = tonumber(x)
	y = tonumber(y)
	z = tonumber(z)

	if not x or not y or not z then
		return nil
	end

	return Vector3.new(x, y, z)
end

