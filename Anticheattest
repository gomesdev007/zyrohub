local Fill = Instance.new("Frame")
Fill.Size = UDim2.new(
	(SpeedValue - MIN_SPEED) / (MAX_SPEED - MIN_SPEED),
	0,
	1,
	0
)
Fill.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
Fill.BorderSizePixel = 0
Fill.Parent = Slider

local FillCorner = Instance.new("UICorner")
FillCorner.CornerRadius = UDim.new(1, 0)
FillCorner.Parent = Fill

local SliderDragging = false

local function setSlider(input)
	local relative = input.Position.X - Slider.AbsolutePosition.X
	local percent = math.clamp(
		relative / Slider.AbsoluteSize.X,
		0,
		1
	)

	SpeedValue = math.floor(
		MIN_SPEED + ((MAX_SPEED - MIN_SPEED) * percent)
	)

	Fill.Size = UDim2.new(percent, 0, 1, 0)
	SpeedText.Text = tostring(SpeedValue)
end

Slider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		SliderDragging = true
		setSlider(input)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if SliderDragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then
		setSlider(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		SliderDragging = false
	end
end)

--==================================================
-- MOVEMENT
--==================================================

local activeTween

local function cancelTween()
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
end

local function tweenToPosition(target)
	if not RootPart then
		return
	end

	cancelTween()

	local distance = (RootPart.Position - target).Magnitude

	if distance < 0.05 then
		return
	end

	-- Speed em studs por segundo
	local duration = distance / SpeedValue

	activeTween = TweenService:Create(
		RootPart,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = CFrame.new(target)
		}
	)

	activeTween:Play()

	activeTween.Completed:Connect(function()
		activeTween = nil
	end)
end

--==================================================
-- LIGHT TWEEN
--==================================================

local lightRunning = false

local function tweenLight(target)
	if not RootPart then
		return
	end

	cancelTween()

	lightRunning = true

	local safety = 0

	while lightRunning and RootPart and safety < 1000 do
		safety += 1

		local current = RootPart.Position
		local offset = target - current
		local distance = offset.Magnitude

		if distance <= 0.5 then
			RootPart.CFrame = CFrame.new(target)
			break
		end

		-- Cada etapa possui no máximo 100 studs
		local stepDistance = math.min(
			LIGHT_SEGMENT_DISTANCE,
			distance
		)

		local direction = offset.Unit
		local nextPosition = current + direction * stepDistance

		local segmentTime = LIGHT_SEGMENT_TIME

		-- Mantém o último trecho proporcional
		if distance < LIGHT_SEGMENT_DISTANCE then
			segmentTime = LIGHT_SEGMENT_TIME * (
				distance / LIGHT_SEGMENT_DISTANCE
			)

			segmentTime = math.max(segmentTime, 0.05)
		end

		local tween = TweenService:Create(
			RootPart,
			TweenInfo.new(
				segmentTime,
				Enum.EasingStyle.Linear,
				Enum.EasingDirection.Out
			),
			{
				CFrame = CFrame.new(nextPosition)
			}
		)

		activeTween = tween
		tween:Play()

		local state = tween.Completed:Wait()

		activeTween = nil

		if state ~= Enum.PlaybackState.Completed then
			break
		end

		task.wait()
	end

	lightRunning = false
	activeTween = nil
end

