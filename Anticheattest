--==================================================
-- PUSH / VELOCITY
--==================================================

local PushButton = createButton(
	"Modo Push / Velocity",
	UDim2.new(0, 10, 0, 332)
)

local pushEnabled = false
local pushConnection

local function stopPush()
	pushEnabled = false

	if pushConnection then
		pushConnection:Disconnect()
		pushConnection = nil
	end
end

local function startPush()
	if pushEnabled then
		return
	end

	pushEnabled = true

	pushConnection = game:GetService("RunService").Heartbeat:Connect(function()
		if not Character
			or not Humanoid
			or not RootPart
			or Humanoid.Health <= 0 then

			return
		end

		local value = tonumber(WalkSpeedBox.Text) or 16

		-- Impulso para frente.
		-- Não modifica Humanoid.WalkSpeed.
		local direction = Humanoid.MoveDirection

		if direction.Magnitude > 0.05 then
			local currentVelocity = RootPart.AssemblyLinearVelocity

			RootPart.AssemblyLinearVelocity = Vector3.new(
				direction.X * value,
				currentVelocity.Y,
				direction.Z * value
			)
		end
	end)
end

PushButton.MouseButton1Click:Connect(function()
	if pushEnabled then
		stopPush()
		PushButton.Text = "Modo Push / Velocity"
	else
		startPush()
		PushButton.Text = "Velocity: ON"
	end
end)

