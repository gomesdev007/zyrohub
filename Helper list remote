-- add
addButton.MouseButton1Click:Connect(function()
	local name = nameBox.Text
	local remote = remoteBox.Text

	if name == "" or remote == "" then
		return
	end

	table.insert(remotes, {
		Name = name,
		Remote = remote
	})

	createRemoteItem(name, remote)

	nameBox.Text = ""
	remoteBox.Text = ""
end)

