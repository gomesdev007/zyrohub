-- Se outro sistema modificar os valores,
-- Ryderhub restaura os valores escolhidos no slider.

task.spawn(function()

    while task.wait(0.05) do

        if Humanoid and Humanoid.Parent then

            if Humanoid.WalkSpeed ~= SpeedValue then
                Humanoid.WalkSpeed = SpeedValue
            end

            if Humanoid.UseJumpPower then

                if Humanoid.JumpPower ~= JumpValue then
                    Humanoid.JumpPower = JumpValue
                end

            else

                if Humanoid.JumpHeight ~= JumpValue then
                    Humanoid.JumpHeight = JumpValue
                end
            end
        end
    end
end)

