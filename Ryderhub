--========================================================
-- OPEN / CLOSE ANIMATION
--========================================================

local function OpenInterface()

    if InterfaceOpen then
        return
    end

    InterfaceOpen = true

    Main.Visible = true
    MainScale.Scale = 0.75

    TweenService:Create(
        MainScale,
        TweenInfo.new(
            0.28,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Scale = 1
        }
    ):Play()
end

local function CloseInterface()

    if not InterfaceOpen then
        return
    end

    InterfaceOpen = false

    local Animation = TweenService:Create(
        MainScale,
        TweenInfo.new(
            0.2,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        ),
        {
            Scale = 0.75
        }
    )

    Animation:Play()

    Animation.Completed:Connect(function()

        if not InterfaceOpen then
            Main.Visible = false
        end
    end)
end

FloatButton.MouseButton1Click:Connect(function()

    if InterfaceOpen then
        CloseInterface()
    else
        OpenInterface()
    end
end)

