--// MONITOR PROMPTS
ProximityPromptService.PromptTriggered:Connect(function(prompt, playerWhoTriggered)

    if not AutoReturn then
        return
    end

    -- Garante que foi o próprio jogador
    if playerWhoTriggered and playerWhoTriggered ~= LocalPlayer then
        return
    end

    Status.Text = "Status: Prompt concluído → retornando..."

    task.spawn(function()
        ReturnToBase()

        if AutoReturn then
            Status.Text = "Status: Na sua base"
        else
            Status.Text = "Status: Ready"
        end
    end)
end)

