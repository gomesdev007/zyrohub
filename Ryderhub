--//====================================================
--// SLIDER
--//====================================================

local function CreateSlider(
    Y,
    Name,
    Min,
    Max,
    Default,
    Callback
)

    local Container = Instance.new("Frame")

    Container.Size =
        UDim2.new(1,-24,0,53)

    Container.Position =
        UDim2.fromOffset(12,Y)

    Container.BackgroundTransparency = 1
    Container.Parent = Main


    --// LABEL
    local Label = Instance.new("TextLabel")

    Label.Size =
        UDim2.new(1,0,0,20)

    Label.Position =
        UDim2.fromOffset(0,0)

    Label.BackgroundTransparency = 1

    Label.Text =
        Name .. ": " .. Default

    Label.TextColor3 =
        Color3.fromRGB(225,225,230)

    Label.TextSize = 11
    Label.Font = Enum.Font.GothamMedium

    Label.TextXAlignment =
        Enum.TextXAlignment.Left

    Label.Parent = Container


    --// BAR
    local Bar = Instance.new("Frame")

    Bar.Size =
        UDim2.new(1,0,0,8)

    Bar.Position =
        UDim2.fromOffset(0,29)

    Bar.BackgroundColor3 =
        Color3.fromRGB(42,42,46)

    Bar.BorderSizePixel = 0
    Bar.Active = true
    Bar.Parent = Container

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(1,0)
    BarCorner.Parent = Bar


    --// FILL
    local Fill = Instance.new("Frame")

    Fill.BackgroundColor3 =
        Color3.fromRGB(215,65,65)

    Fill.BorderSizePixel = 0
    Fill.Parent = Bar

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1,0)
    FillCorner.Parent = Fill


    --// KNOB
    local Knob = Instance.new("TextButton")

    Knob.Size =
        UDim2.fromOffset(18,18)

    Knob.AnchorPoint =
        Vector2.new(0.5,0.5)

    Knob.BackgroundColor3 =
        Color3.fromRGB(255,255,255)

    Knob.BorderSizePixel = 0
    Knob.Text = ""
    Knob.AutoButtonColor = false
    Knob.ZIndex = 5
    Knob.Parent = Bar

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1,0)
    KnobCorner.Parent = Knob

    local KnobScale = Instance.new("UIScale")
    KnobScale.Scale = 1
    KnobScale.Parent = Knob


    local Sliding = false


    --//================================================
    --// APLICA VALOR
    --//================================================

    local function ApplyValue(Value)

        if not Humanoid then
            Callback(Value)
            return
        end


        if Name == "SPEED" then

            -- Guarda o valor atual antes da alteração
            local OldValue =
                Humanoid.WalkSpeed

            -- Restaura primeiro
            Humanoid.WalkSpeed =
                OldValue

            task.wait()

            -- Aplica o novo valor
            Humanoid.WalkSpeed =
                Value


        elseif Name == "JUMP" then

            if Humanoid.UseJumpPower then

                local OldValue =
                    Humanoid.JumpPower

                Humanoid.JumpPower =
                    OldValue

                task.wait()

                Humanoid.JumpPower =
                    Value

            else

                local OldValue =
                    Humanoid.JumpHeight

                Humanoid.JumpHeight =
                    OldValue

                task.wait()

                Humanoid.JumpHeight =
                    Value
            end
        end

        Callback(Value)
    end


    --//================================================
    --// SET VALUE
    --//================================================

    local function SetValue(X)

        local Width =
            Bar.AbsoluteSize.X

        if Width <= 0 then
            return
        end

        local Percent =
            math.clamp(
                (X - Bar.AbsolutePosition.X) / Width,
                0,
                1
            )

        local Value =
            math.floor(
                Min +
                ((Max-Min) * Percent)
                + 0.5
            )


        Label.Text =
            Name .. ": " .. Value


        TweenService:Create(
            Fill,

            TweenInfo.new(
                0.07,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),

            {
                Size =
                    UDim2.new(
                        Percent,
                        0,
                        1,
                        0
                    )
            }
        ):Play()


        TweenService:Create(
            Knob,

            TweenInfo.new(
                0.07,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),

            {
                Position =
                    UDim2.new(
                        Percent,
                        0,
                        0.5,
                        0
                    )
            }
        ):Play()


        ApplyValue(Value)
    end


    --//================================================
    --// BEGIN SLIDE
    --//================================================

    local function BeginSlide(Input)

        if Input.UserInputType ~=
            Enum.UserInputType.MouseButton1
            and
            Input.UserInputType ~=
            Enum.UserInputType.Touch then

            return
        end

        Sliding = true

        TweenService:Create(
            KnobScale,

            TweenInfo.new(0.12),

            {
                Scale = 1.3
            }
        ):Play()

        SetValue(Input.Position.X)
    end


    Knob.InputBegan:Connect(BeginSlide)
    Bar.InputBegan:Connect(BeginSlide)


    --//================================================
    --// SLIDE
    --//================================================

    UserInputService.InputChanged:Connect(function(Input)

        if not Sliding then
            return
        end

        if Input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or
            Input.UserInputType ==
            Enum.UserInputType.Touch then

            SetValue(Input.Position.X)
        end
    end)


    --//================================================
    --// END SLIDE
    --//================================================

    UserInputService.InputEnded:Connect(function(Input)

        if Input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or
            Input.UserInputType ==
            Enum.UserInputType.Touch then

            if Sliding then

                Sliding = false

                TweenService:Create(
                    KnobScale,

                    TweenInfo.new(
                        0.16,
                        Enum.EasingStyle.Back,
                        Enum.EasingDirection.Out
                    ),

                    {
                        Scale = 1
                    }
                ):Play()
            end
        end
    end)


    --//================================================
    --// DEFAULT
    --//================================================

    task.defer(function()

        local Percent =
            (Default-Min)/(Max-Min)

        Fill.Size =
            UDim2.new(
                Percent,
                0,
                1,
                0
            )

        Knob.Position =
            UDim2.new(
                Percent,
                0,
                0.5,
                0
            )
    end)
end


