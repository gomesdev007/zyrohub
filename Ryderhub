end)

--========================================================
-- ANTI DROP HOOK
--========================================================

task.spawn(function()

    if type(hookmetamethod) ~= "function" then

        warn(
            "[Ryderhub] Este executor não possui hookmetamethod."
        )

        return
    end

    local Target

    local success = pcall(function()

        Target =
            workspace
            :WaitForChild("Remotes",10)
            :WaitForChild("DropEggRequest",10)

    end)

    if not success or not Target then

        warn(
            "[Ryderhub] DropEggRequest não encontrado."
        )

        return
    end

    local OldNamecall

    OldNamecall = hookmetamethod(
        game,
        "__namecall",
        newcclosure(function(self,...)

            local method =
                getnamecallmethod()

            if AntiDrop
            and self == Target
            and method == "FireServer" then

                return nil
            end

            return OldNamecall(self,...)
        end)
    )

    print(
        "[Ryderhub] Anti Drop carregado."
    )
end)

