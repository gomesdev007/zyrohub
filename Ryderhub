--========================================================
-- OPEN / CLOSE
--========================================================

local function OpenGui()

    if Open then
        return
    end

    Open = true
    Main.Visible = true
    MainScale.Scale = 0.75

    TweenService:Create(
        MainScale,
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {Scale = 1}
    ):Play()
end

local function CloseGui()

    if not Open then
        return
    end

    Open = false

    local Tween = TweenService:Create(
        MainScale,
        TweenInfo.new(
            0.2,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        ),
        {Scale = 0.75}
    )

    Tween:Play()

    task.delay(0.2,function()

        if not Open then
            Main.Visible = false
        end
    end)
end

Float.MouseButton1Click:Connect(function()

    if Open then
        CloseGui()
    else
        OpenGui()
    end
end)

--========================================================
-- PROMPT -> RETURN
--========================================================

ProximityPromptService.PromptTriggered:Connect(
    function(prompt, playerWhoTriggered)

        if not AutoReturn then
            return
        end

        if playerWhoTriggered
        and playerWhoTriggered ~= Player then
            return
        end

        if Returning then
            return
        end

        local char = Player.Character

        if not char then
            return
        end

        local root =
            char:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        Returning = true

        Status.Text =
            "PROMPT → RETURNING"

        local distance =
            (root.Position-ReturnPosition).Magnitude

        local duration =
            math.max(distance/ReturnSpeed,0.05)

        local tween = TweenService:Create(
            root,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame =
                    CFrame.new(ReturnPosition)
            }
        )

        tween:Play()

        tween.Completed:Wait()

        Returning = false

        Status.Text = "READY"
    end
)

