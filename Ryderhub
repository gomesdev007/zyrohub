local LocalPlayer = Players.LocalPlayer

local WalkSpeed = 16
local JumpPower = 50
local ReturnSpeed = 150
local AutoReturn = false
local Returning = false

--// CHARACTER
local Character
local Humanoid
local Root

local function UpdateCharacter()
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    Humanoid = Character:WaitForChild("Humanoid")
    Root = Character:WaitForChild("HumanoidRootPart")

    Humanoid.WalkSpeed = WalkSpeed

    if Humanoid.UseJumpPower then
        Humanoid.JumpPower = JumpPower
    else
        Humanoid.JumpHeight = JumpPower
    end
end

UpdateCharacter()

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    UpdateCharacter()
end)

--// FIND PLAYER PLOT
local function GetMyPlot()
    local maps = workspace:FindFirstChild("Maps")
    if not maps then
        return nil
    end

    local plots = maps:FindFirstChild("Plots")
    if not plots then
        return nil
    end

    local playerPlot = LocalPlayer:FindFirstChild("Plot")

    if not playerPlot then
        return nil
    end

    -- Plot pode ser ObjectValue
    if playerPlot:IsA("ObjectValue") and playerPlot.Value then
        return playerPlot.Value
    end

    -- Plot pode ser StringValue
    if playerPlot:IsA("StringValue") then
        local found = plots:FindFirstChild(playerPlot.Value, true)
        if found then
            return found
        end
    end

    -- Plot pode ser número
    if playerPlot:IsA("IntValue") or playerPlot:IsA("NumberValue") then
        for _, plot in ipairs(plots:GetChildren()) do
            local id = plot:GetAttribute("Plot")
                or plot:GetAttribute("PlotId")
                or plot:GetAttribute("Id")

            if id == playerPlot.Value then
                return plot
            end
        end
    end

    -- Procura pelo nome/atributo do jogador
    for _, plot in ipairs(plots:GetChildren()) do
        local owner = plot:GetAttribute("Owner")
            or plot:GetAttribute("OwnerName")
            or plot:GetAttribute("Player")

        if owner == LocalPlayer.Name or owner == LocalPlayer.UserId then
            return plot
        end
    end

    return nil
end

--// FIND POSITION INSIDE PLOT
local function GetPlotPosition(plot)
    if not plot then
        return nil
    end

    -- Nomes comuns de partes de retorno/base
    local names = {
        "Base",
        "BasePart",
        "Spawn",
        "SpawnLocation",
        "Home",
        "OwnerSpawn",
        "PlayerSpawn",
        "PlotSpawn",
        "ClaimSpawn",
        "Teleport",
        "Return"
    }

    for _, name in ipairs(names) do
        local obj = plot:FindFirstChild(name, true)

        if obj then
            if obj:IsA("BasePart") then
                return obj.CFrame
            elseif obj:IsA("Model") and obj.PrimaryPart then
                return obj.PrimaryPart.CFrame
            end
        end
    end

    if plot:IsA("Model") and plot.PrimaryPart then
        return plot.PrimaryPart.CFrame
    end

    -- Último recurso: primeira BasePart encontrada
    for _, obj in ipairs(plot:GetDescendants()) do
        if obj:IsA("BasePart") then
            return obj.CFrame
        end
    end

    return nil
end

--// RETURN TO BASE
local function ReturnToBase()
    if Returning or not AutoReturn then
        return
    end

    if not Character or not Root then
        return
    end

    local plot = GetMyPlot()

    if not plot then
        warn("[AUTO RETURN] Seu Plot não foi encontrado.")
        return
    end

    local targetCFrame = GetPlotPosition(plot)

    if not targetCFrame then
        warn("[AUTO RETURN] Não encontrei uma posição dentro do seu Plot.")
        return
    end

    Returning = true

    -- Pequena altura para não ficar preso no chão
    targetCFrame = targetCFrame + Vector3.new(0, 3, 0)

    local distance = (Root.Position - targetCFrame.Position).Magnitude
    local duration = distance / ReturnSpeed

    duration = math.max(duration, 0.05)

    local tween = TweenService:Create(
        Root,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = targetCFrame
        }
    )

    tween:Play()
    tween.Completed:Wait()

    Returning = false
end

