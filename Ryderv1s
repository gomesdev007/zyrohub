local function createToggle(y, name, callback)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -30, 0, 43)
    holder.Position = UDim2.new(0, 15, 0, y)
    holder.BackgroundColor3 = Color3.fromRGB(19, 19, 23)
    holder.BorderSizePixel = 0
    holder.Parent = Main

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = holder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -65, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.Text = name
    label.TextColor3 = Color3.fromRGB(235, 235, 240)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(0, 35, 1, 0)
    status.Position = UDim2.new(1, -76, 0, 0)
    status.BackgroundTransparency = 1
    status.Font = Enum.Font.Gotham
    status.TextSize = 9
    status.Text = "OFF"
    status.TextColor3 = Color3.fromRGB(110, 110, 118)
    status.Parent = holder

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 38, 0, 20)
    button.Position = UDim2.new(1, -48, 0.5, -10)
    button.BackgroundColor3 = Color3.fromRGB(48, 48, 55)
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = holder

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(1, 0)
    buttonCorner.Parent = button

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = UDim2.new(0, 3, 0.5, -7)
    dot.BackgroundColor3 = Color3.fromRGB(180, 180, 185)
    dot.BorderSizePixel = 0
    dot.Parent = button

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = dot

    local enabled = false

    button.MouseButton1Click:Connect(function()
        enabled = not enabled

        if enabled then
            status.Text = "ON"
            status.TextColor3 = Color3.fromRGB(235, 45, 55)

            TweenService:Create(
                button,
                TweenInfo.new(0.15),
                {BackgroundColor3 = Color3.fromRGB(95, 25, 30)}
            ):Play()

            TweenService:Create(
                dot,
                TweenInfo.new(0.15),
                {
                    Position = UDim2.new(1, -17, 0.5, -7),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                }
            ):Play()
        else
            status.Text = "OFF"
            status.TextColor3 = Color3.fromRGB(110, 110, 118)

            TweenService:Create(
                button,
                TweenInfo.new(0.15),
                {BackgroundColor3 = Color3.fromRGB(48, 48, 55)}
            ):Play()

            TweenService:Create(
                dot,
                TweenInfo.new(0.15),
                {
                    Position = UDim2.new(0, 3, 0.5, -7),
                    BackgroundColor3 = Color3.fromRGB(180, 180, 185)
                }
            ):Play()
        end

        callback(enabled)
    end)

    return holder
end

