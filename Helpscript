    box.PlaceholderColor3 = Color3.fromRGB(110, 110, 110)
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(235, 235, 235)
    box.TextSize = 13
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.Parent = main
    corner(box, 8)
    stroke(box)
    return box
end

