--// GERAR LOADSTRING
generate.MouseButton1Click:Connect(function()
    local repo = repoBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local file = fileBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

    if repo == "" or file == "" then
        result.Text = "Preencha o repositório e o arquivo."
        return
    end

    -- Se o usuário não colocou .lua, adiciona automaticamente
    if not file:lower():match("%.lua$") then
        file = file .. ".lua"
    end

    local raw = "https://raw.githubusercontent.com/gomesdev007/"
        .. repo
        .. "/refs/heads/main/"
        .. file

    result.Text = 'loadstring(game:HttpGet("' .. raw .. '"))()'
end)

