local function expandParents(object)
	if not object then
		return
	end

	local chain={}
	local current=object.Parent

	while current and current~=game do
		table.insert(chain,current)
		current=current.Parent
	end

	for _,parent in ipairs(chain) do
		expanded[parent]=true
	end
end

