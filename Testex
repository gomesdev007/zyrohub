local function closeOnOutsideClick(input)
    if not InfoGui or not InfoGui.Parent then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    local pos = input.Position

    if not InfoFrame then
        return
    end

    local p = InfoFrame.AbsolutePosition
    local s = InfoFrame.AbsoluteSize

    local inside =
        pos.X >= p.X
        and pos.X <= p.X + s.X
        and pos.Y >= p.Y
        and pos.Y <= p.Y + s.Y

    if not inside then
        closeObjectInfo()
    end
end

