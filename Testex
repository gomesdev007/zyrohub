local function countObjects(object)
	local total=1
	local meaningfulCount=0

	if isMeaningful(object) then
		meaningfulCount=1
	end

	for _,child in ipairs(object:GetDescendants()) do
		total+=1

		if isMeaningful(child) then
			meaningfulCount+=1
		end
	end

	return total,meaningfulCount
end

local function updateRootStatus()
	local r=root()

	if not r then
		Status.Text="Fonte indisponível"
		return
	end

	local total,meaningfulCount=countObjects(r)

	Status.Text=string.format(
		"%s • %d objetos • %d exibíveis",
		r.Name,
		total,
		meaningfulCount
	)
end

