local function connectSourceWatch(sourceObject)
	if not sourceObject then
		return
	end

	local add=sourceObject.DescendantAdded:Connect(function()
		if selectedMode=="All" and not scanning and not minimized then
			task.defer(function()
				if not scanning then
					renderExplorer()
				end
			end)
		end
	end)

	local remove=sourceObject.DescendantRemoving:Connect(function(object)
		if selectedObject==object then
			selectedObject=nil
		end

		if selectedMode=="All" and not scanning and not minimized then
			task.defer(function()
				if not scanning then
					renderExplorer()
				end
			end)
		end
	end)

	table.insert(sourceConnections,add)
	table.insert(sourceConnections,remove)
end

