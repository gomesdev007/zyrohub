local function report()
	local t={
		"GOMES EXPLORER",
		"Fonte: "..selectedSource,
		"Modo: "..selectedMode,
		""
	}

	if #currentResults>0 then
		for _,o in ipairs(currentResults) do
			if o and o.Parent then
				table.insert(t,o:GetFullName())
			end
		end
	elseif selectedObject and selectedObject.Parent then
		table.insert(t,selectedObject:GetFullName())
	else
		local r=root()
		table.insert(t,r:GetFullName())
		for _,o in ipairs(r:GetDescendants()) do
			if isMeaningful(o) then
				table.insert(t,o:GetFullName())
			end
		end
	end

	return table.concat(t,"\n")
end

