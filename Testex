local function isMeaningful(o)
	if o.ClassName=="Terrain" or o.ClassName=="SurfaceAppearance" then
		return false
	end
	return meaningful[o.ClassName] or o:IsA("BasePart")
end

local function hasMeaningful(o)
	for _,c in ipairs(o:GetChildren()) do
		if isMeaningful(c) or hasMeaningful(c) then
			return true
		end
	end
	return false
end

local function root()
	if selectedSource=="Workspace" then
		return workspace
	elseif selectedSource=="ReplicatedStorage" then
		return ReplicatedStorage
	else
		return Players
	end
end

local function path(o)
	local t={}
	local x=o
	while x and x~=game do
		table.insert(t,1,x.Name)
		x=x.Parent
	end
	return table.concat(t,".")
end

local function icon(o)
	if o:IsA("Folder") then return "📁" end
	if o:IsA("Model") then return "◈" end
	if o:IsA("BasePart") then return "■" end
	if o:IsA("ProximityPrompt") then return "⌁" end
	if o:IsA("RemoteEvent") or o:IsA("BindableEvent") then return "⚡" end
	if o:IsA("RemoteFunction") or o:IsA("BindableFunction") then return "ƒ" end
	if o:IsA("ModuleScript") then return "M" end
	if o:IsA("LocalScript") then return "L" end
	if o:IsA("Script") then return "S" end
	if o:IsA("Attachment") then return "●" end
	if o:IsA("ValueBase") then return "=" end
	if o:IsA("Camera") then return "◎" end
	if o:IsA("Sound") then return "♫" end
	if o:IsA("ParticleEmitter") then return "*" end
	return "•"
end

