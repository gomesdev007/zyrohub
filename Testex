local function getAttributesText(object)
	local attributes=object:GetAttributes()
	local names={}

	for name in pairs(attributes) do
		table.insert(names,name)
	end

	table.sort(names)

	if #names==0 then
		return "Nenhum"
	end

	local lines={}

	for _,name in ipairs(names) do
		table.insert(
			lines,
			name.." = "..valueText(attributes[name])
		)
	end

	return table.concat(lines," | ")
end

local function getObjectInfo(object)
	local info={}

	table.insert(info,{"Name",object.Name})
	table.insert(info,{"ClassName",object.ClassName})
	table.insert(info,{"Full Path",object:GetFullName()})

	if object.Parent then
		table.insert(info,{"Parent",object.Parent:GetFullName()})
	else
		table.insert(info,{"Parent","nil"})
	end

	table.insert(info,{"Children",#object:GetChildren()})
	table.insert(info,{"Descendants",#object:GetDescendants()})

	local archivable=safeGet(object,"Archivable")
	if archivable~=nil then
		table.insert(info,{"Archivable",archivable})
	end

	if object:IsA("BasePart") then
		table.insert(info,{"Position",object.Position})
		table.insert(info,{"Size",object.Size})
		table.insert(info,{"Orientation",object.Orientation})
		table.insert(info,{"Anchored",object.Anchored})
		table.insert(info,{"CanCollide",object.CanCollide})
		table.insert(info,{"CanTouch",object.CanTouch})
		table.insert(info,{"CanQuery",object.CanQuery})
		table.insert(info,{"Transparency",object.Transparency})
		table.insert(info,{"Material",object.Material})
		table.insert(info,{"Color",object.Color})
	end

	if object:IsA("Model") then
		local primary=object.PrimaryPart

		if primary then
			table.insert(info,{"PrimaryPart",primary:GetFullName()})
		else
			table.insert(info,{"PrimaryPart","nil"})
		end

		local pivot=object:GetPivot()
		table.insert(info,{"WorldPivot",pivot})
	end

	if object:IsA("ProximityPrompt") then
		table.insert(info,{"ActionText",object.ActionText})
		table.insert(info,{"ObjectText",object.ObjectText})
		table.insert(info,{"HoldDuration",object.HoldDuration})
		table.insert(info,{"MaxActivationDistance",object.MaxActivationDistance})
		table.insert(info,{"Enabled",object.Enabled})
		table.insert(info,{"KeyboardKeyCode",object.KeyboardKeyCode})
		table.insert(info,{"GamepadKeyCode",object.GamepadKeyCode})
		table.insert(info,{"RequiresLineOfSight",object.RequiresLineOfSight})
	end

	if object:IsA("Sound") then
		table.insert(info,{"SoundId",object.SoundId})
		table.insert(info,{"Volume",object.Volume})
		table.insert(info,{"Playing",object.Playing})
		table.insert(info,{"Looped",object.Looped})
	end

	if object:IsA("ParticleEmitter") then
		table.insert(info,{"Rate",object.Rate})
		table.insert(info,{"Lifetime",object.Lifetime})
		table.insert(info,{"Enabled",object.Enabled})
	end

	if object:IsA("Attachment") then
		table.insert(info,{"Position",object.Position})
		table.insert(info,{"Orientation",object.Orientation})
		table.insert(info,{"WorldPosition",object.WorldPosition})
	end

	table.insert(info,{"Attributes",getAttributesText(object)})

	return info
end

local function destroyViewer()
	if ViewerConnection then
		ViewerConnection:Disconnect()
		ViewerConnection=nil
	end

	if ViewerDragConnection then
		ViewerDragConnection:Disconnect()
		ViewerDragConnection=nil
	end

	if ViewerInputConnection then
		ViewerInputConnection:Disconnect()
		ViewerInputConnection=nil
	end

	if ViewerTouchConnection then
		ViewerTouchConnection:Disconnect()
		ViewerTouchConnection=nil
	end

	if ViewerWorld then
		for _,child in ipairs(ViewerWorld:GetChildren()) do
			child:Destroy()
		end
	end

	ViewerModel=nil
	viewerYaw=0
	viewerPitch=0
	viewerDistance=8
	viewerDragging=false
	viewerLastPosition=nil
end

local function createViewport(object,holder)
	destroyViewer()

	local canDisplay=false

	if object:IsA("BasePart") or object:IsA("Model") then
		canDisplay=true
	elseif object:IsA("Accessory") then
		canDisplay=true
	end

	if not canDisplay then
		local unavailable=Instance.new("TextLabel")
		unavailable.Size=UDim2.new(1,0,1,0)
		unavailable.BackgroundTransparency=1
		unavailable.Font=Enum.Font.Gotham
		unavailable.Text="Visualização 3D indisponível\npara este objeto."
		unavailable.TextColor3=Color3.fromRGB(130,130,140)
		unavailable.TextSize=11
		unavailable.TextWrapped=true
		unavailable.Parent=holder
		return
	end

	Viewer=Instance.new("ViewportFrame")
	Viewer.Name="Viewer3D"
	Viewer.Size=UDim2.new(1,0,1,0)
	Viewer.BackgroundColor3=Color3.fromRGB(8,8,11)
	Viewer.BorderSizePixel=0
	Viewer.Ambient=Color3.fromRGB(180,180,180)
	Viewer.LightColor=Color3.fromRGB(255,255,255)
	Viewer.LightDirection=Vector3.new(-1,-1,-1)
	Viewer.Parent=holder

	ViewerWorld=Instance.new("WorldModel")
	ViewerWorld.Parent=Viewer

	ViewerCamera=Instance.new("Camera")
	ViewerCamera.FieldOfView=45
	ViewerCamera.Parent=Viewer
	Viewer.CurrentCamera=ViewerCamera

	local clone=nil

	local ok=pcall(function()
		clone=object:Clone()
	end)

	if not ok or not clone then
		local fail=Instance.new("TextLabel")
		fail.Size=UDim2.new(1,0,1,0)
		fail.BackgroundTransparency=1
		fail.Font=Enum.Font.Gotham
		fail.Text="Não foi possível clonar\neste objeto para o Viewer."
		fail.TextColor3=Color3.fromRGB(150,150,160)
		fail.TextSize=10
		fail.TextWrapped=true
		fail.Parent=Viewer
		return
	end

	ViewerModel=clone
	clone.Parent=ViewerWorld

	for _,desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("Script")
			or desc:IsA("LocalScript")
			or desc:IsA("ModuleScript")
			or desc:IsA("ProximityPrompt")
			or desc:IsA("ClickDetector") then
			desc:Destroy()
		elseif desc:IsA("BasePart") then
			desc.Anchored=true
			desc.CanCollide=false
			desc.CanTouch=false
			desc.CanQuery=false
		end
	end

	local center=Vector3.zero
	local size=Vector3.new(4,4,4)

	if clone:IsA("Model") then
		local okBox,cf,box=pcall(function()
			return clone:GetBoundingBox()
		end)

		if okBox then
			center=cf.Position
			size=box
		end
	elseif clone:IsA("BasePart") then
		center=clone.Position
		size=clone.Size
	end

	if clone:IsA("Model") then
		local pivot=clone:GetPivot()
		clone:PivotTo(CFrame.new(-center)*pivot)
	elseif clone:IsA("BasePart") then
		clone.CFrame=clone.CFrame+(-center)
	end

	local maxSize=math.max(size.X,size.Y,size.Z)
	viewerDistance=math.max(5,maxSize*2.4)

	local function updateCamera()
		if not ViewerCamera then return end

		local rotation=
			CFrame.Angles(0,math.rad(viewerYaw),0)*
			CFrame.Angles(math.rad(viewerPitch),0,0)

		local offset=rotation:VectorToWorldSpace(
			Vector3.new(0,0,viewerDistance)
		)

		ViewerCamera.CFrame=CFrame.lookAt(
			offset,
			Vector3.zero
		)
	end

	updateCamera()

	ViewerInputConnection=Viewer.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
			or input.UserInputType==Enum.UserInputType.Touch then

			viewerDragging=true
			viewerLastPosition=input.Position
		end
	end)

	ViewerTouchConnection=Viewer.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
			or input.UserInputType==Enum.UserInputType.Touch then

			viewerDragging=false
			viewerLastPosition=nil
		end
	end)

	ViewerDragConnection=UIS.InputChanged:Connect(function(input)
		if not viewerDragging then return end
		if not viewerLastPosition then
			viewerLastPosition=input.Position
			return
		end

		if input.UserInputType==Enum.UserInputType.MouseMovement
			or input.UserInputType==Enum.UserInputType.Touch then

			local delta=input.Position-viewerLastPosition
			viewerLastPosition=input.Position

			viewerYaw=viewerYaw-delta.X*.5
			viewerPitch=math.clamp(
				viewerPitch-delta.Y*.35,
				-80,
				80
			)

			updateCamera()
		end
	end)

	ViewerConnection=UIS.InputChanged:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseWheel then
			local z=input.Position.Z

			viewerDistance=math.clamp(
				viewerDistance-z*1.2,
				math.max(2,maxSize*.45),
				math.max(30,maxSize*8)
			)

			updateCamera()
		end
	end)
end

