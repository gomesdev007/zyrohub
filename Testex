	local children=#o:GetChildren()>0
	local exp=expanded[o]==true

	New("TextLabel",{
		Position=UDim2.new(0,indent,0,0),
		Size=UDim2.new(0,16,1,0),
		BackgroundTransparency=1,
		Font=Enum.Font.GothamBold,
		Text=children and (exp and "▼" or "▶") or "",
		TextColor3=Color3.fromRGB(145,145,155),
		TextSize=9
	},b)

	New("TextLabel",{
		Position=UDim2.new(0,indent+17,0,0),
		Size=UDim2.new(0,22,1,0),
		BackgroundTransparency=1,
		Font=Enum.Font.Gotham,
		Text=icon(o),
		TextSize=11,
		TextColor3=Color3.fromRGB(190,190,200)
	},b)

	New("TextLabel",{
		Position=UDim2.new(0,indent+42,0,0),
		Size=UDim2.new(1,-indent-48,1,0),
		BackgroundTransparency=1,
		Font=Enum.Font.Gotham,
		Text=o.Name,
		TextColor3=Color3.fromRGB(225,225,230),
		TextSize=10,
		TextXAlignment=Enum.TextXAlignment.Left,
		TextTruncate=Enum.TextTruncate.AtEnd
	},b)

	buttons[o]=b

	local last=0

	b.MouseEnter:Connect(function()
		if selectedObject~=o then
			b.BackgroundColor3=Color3.fromRGB(29,29,36)
			b.BackgroundTransparency=.15
		end
	end)

	b.MouseLeave:Connect(function()
		if selectedObject~=o then
			b.BackgroundTransparency=1
		end
	end)

	b.MouseButton1Click:Connect(function()
		local now=tick()
		local dbl=now-last<=.32
		last=now

		select(o,b)

		if dbl then
			if openObjectInfo then
				openObjectInfo(o)
			end
			return
		end

		if children and selectedMode=="All" then
			expanded[o]=not expanded[o]
			task.defer(function()
				if not scanning then
					renderExplorer()
				end
			end)
		end
	end)

	return b
end

renderExplorer=function()
	if scanning then return end

	for _,v in ipairs(Results:GetChildren()) do
		if v:IsA("GuiObject") then v:Destroy() end
	end

	table.clear(buttons)

	local r=root()
	if not r then return end

	expanded[r]=true
	treeButton(r,0)

	local function render(parent,depth)
		if not expanded[parent] then return end

		local list=parent:GetChildren()

		table.sort(list,function(a,b)
			local am=isMeaningful(a)
			local bm=isMeaningful(b)
			if am~=bm then return am end

			local ac=a:IsA("Folder") or a:IsA("Model")
			local bc=b:IsA("Folder") or b:IsA("Model")
			if ac~=bc then return ac end

			return a.Name:lower()<b.Name:lower()
		end)

		for _,c in ipairs(list) do
			if isMeaningful(c) or hasMeaningful(c) then
				treeButton(c,depth)
				if expanded[c] then
					render(c,depth+1)
				end
			end
		end
	end

	render(r,1)
	Status.Text="Explorer • "..r.Name
end

local function searchObjects(r,q,mode)
	local out={}
	q=q:lower()

	local function match(o)
		local n=o.Name:lower()
		if mode=="Exact" then
			return n==q
		end
		return n:find(q,1,true)~=nil
	end

	if match(r) then table.insert(out,r) end

	for _,o in ipairs(r:GetDescendants()) do
		if match(o) then
			table.insert(out,o)
		end
	end

	table.sort(out,function(a,b)
		return path(a):lower()<path(b):lower()
	end)

	return out
end

local function renderSearch(list)
	clear()

	for _,o in ipairs(list) do
		table.insert(currentResults,o)
		local b=treeButton(o,0)

		local p=New("TextLabel",{
			Position=UDim2.new(0,44,0,16),
			Size=UDim2.new(1,-50,0,10),
			BackgroundTransparency=1,
			Font=Enum.Font.Gotham,
			Text=path(o),
			TextColor3=Color3.fromRGB(100,100,110),
			TextSize=7,
			TextXAlignment=Enum.TextXAlignment.Left,
			TextTruncate=Enum.TextTruncate.AtEnd
		},b)
	end

	Status.Text=#list.." resultado(s)"
end

function performScan()
	if scanning then return end
	scanning=true
	Scan.Text="SCANNING..."
	clear()

	task.wait()

	local r=root()

	if selectedMode=="All" then
		Status.Text="Carregando Explorer..."
		expanded[r]=true
		renderExplorer()
	else
		local q=Search.Text
		if q=="" then
			Status.Text="Digite algo para pesquisar"
		else
			Status.Text="Pesquisando..."
			task.wait()
			renderSearch(searchObjects(r,q,selectedMode))
		end
	end

	scanning=false
	Scan.Text="SCAN"
end

