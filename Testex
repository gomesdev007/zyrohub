local function finalTreeVisible(obj)
    if not obj then
        return false
    end

    if obj:IsA("BasePart") then
        return false
    end

    if obj:IsA("Attachment") then
        return false
    end

    if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then
        return false
    end

    return meaningful[obj.ClassName] == true
        or obj:IsA("Model")
        or obj:IsA("Folder")
        or obj:IsA("Configuration")
        or obj:IsA("Tool")
        or obj:IsA("ScreenGui")
        or obj:IsA("GuiObject")
end

local function finalHasVisibleChild(obj)
    for _, child in ipairs(obj:GetChildren()) do
        if finalTreeVisible(child) then
            return true
        end

        if finalHasVisibleChild(child) then
            return true
        end
    end

    return false
end

local function finalShouldShow(obj)
    if not obj then
        return false
    end

    if selectedMode == "All" then
        return finalTreeVisible(obj) or finalHasVisibleChild(obj)
    end

    return true
end

local function finalRenderExplorer()
    clear()

    local sourceRoot = source()

    if not sourceRoot then
        Status.Text = "Fonte não encontrada"
        return
    end

    local children = sourceRoot:GetChildren()

    table.sort(children, function(a,b)
        return a.Name:lower() < b.Name:lower()
    end)

    local shown = 0

    local function addNode(obj, depth)
        if shown > 1200 then
            return
        end

        if not finalShouldShow(obj) then
            return
        end

        shown += 1

        local row = treeButton(obj, depth)

        if expanded[obj] then
            local sub = {}

            for _, child in ipairs(obj:GetChildren()) do
                if finalShouldShow(child) then
                    table.insert(sub, child)
                end
            end

            table.sort(sub, function(a,b)
                return a.Name:lower() < b.Name:lower()
            end)

            for _, child in ipairs(sub) do
                addNode(child, depth + 1)
            end
        end
    end

    for _, obj in ipairs(children) do
        addNode(obj, 0)
    end

    if shown == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1,-20,0,40)
        empty.Position = UDim2.new(0,10,0,10)
        empty.BackgroundTransparency = 1
        empty.Text = "Nenhum objeto relevante encontrado"
        empty.TextColor3 = Color3.fromRGB(150,150,150)
        empty.TextSize = 13
        empty.Font = Enum.Font.Gotham
        empty.Parent = Results
    end

    Status.Text = tostring(shown) .. " objeto(s)"
end

renderExplorer = finalRenderExplorer

local function finalSearchObjects(text)
    local rootObject = source()

    if not rootObject then
        return {}
    end

    text = tostring(text or ""):lower()

    if text == "" then
        return {}
    end

    local found = {}

    local all = rootObject:GetDescendants()

    for _, obj in ipairs(all) do
        local name = obj.Name:lower()
        local className = obj.ClassName:lower()

        local match = false

        if selectedMode == "Exact" then
            match = name == text
        elseif selectedMode == "Approximate" then
            match = name:find(text, 1, true) ~= nil
        else
            match =
                name:find(text, 1, true) ~= nil
                or className:find(text, 1, true) ~= nil
        end

        if match then
            table.insert(found, obj)
        end
    end

    table.sort(found, function(a,b)
        local an = a.Name:lower()
        local bn = b.Name:lower()

        if an == bn then
            return a.ClassName < b.ClassName
        end

        return an < bn
    end)

    return found
end

