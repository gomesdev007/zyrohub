local function select(o,b)
	selectedObject=o
	for obj,btn in pairs(buttons) do
		if btn and btn.Parent then
			btn.BackgroundTransparency=obj==o and 0 or 1
			if obj==o then
				btn.BackgroundColor3=Color3.fromRGB(52,52,63)
			end
		end
	end
	if b then
		b.BackgroundTransparency=0
		b.BackgroundColor3=Color3.fromRGB(52,52,63)
	end
	Status.Text=path(o)
end

